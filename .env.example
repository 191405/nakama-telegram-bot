# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_from_botfather

# Database URL (SQLite or PostgreSQL)
# For SQLite (default out-of-the-box):
DATABASE_URL=sqlite+aiosqlite:///filebot.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://botuser:botpass@localhost:5432/filebot

# Admin Telegram user IDs (comma-separated, e.g. 123456789,987654321)
ADMIN_IDS=123456789

# Optional: Force subscription channel username (e.g. @yourchannel)
# FORCE_SUB_CHANNEL=@yourchannel

# Optional: Channels
# Public updates channel for newly indexed anime announcements
# UPDATE_CHANNEL=-100xxxxxxxxxx or @channelname
# Private storage channel for sub-bot uploads & indexing
# STORAGE_CHANNEL=-100xxxxxxxxxx or @channelname
# Channel for user requests
# REQUEST_CHANNEL=-100xxxxxxxxxx or @channelname

# Bot behavior settings
RATE_LIMIT=30
AUTO_DELETE_MINUTES=10
PAGE_SIZE=8

# Optional: Google Gemini AI Concierge API key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Sub-Bot Worker (worker/rss_sub_bot.py)
SUB_BOT_TOKEN=your_sub_bot_token_from_botfather
SUBSPLEASE_RSS=https://subsplease.org/rss/?r=1080
CHECK_INTERVAL_SECONDS=300
