# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_from_botfather

# Database URL (SQLite or PostgreSQL)
# For SQLite (default out-of-the-box):
DATABASE_URL=sqlite+aiosqlite:///filebot.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://botuser:botpass@localhost:5432/filebot

# Admin Telegram user IDs (comma-separated, e.g. 123456789,987654321)
ADMIN_IDS=123456789

# Optional: Force subscription channel username (e.g. @yourchannel)
# FORCE_SUB_CHANNEL=@yourchannel

# Optional: Channels
# Public updates channel for newly indexed anime announcements
# UPDATE_CHANNEL=-100xxxxxxxxxx or @channelname
# Private storage channel for sub-bot uploads & indexing
# STORAGE_CHANNEL=-100xxxxxxxxxx or @channelname
# Channel for user requests
# REQUEST_CHANNEL=-100xxxxxxxxxx or @channelname

# Bot behavior settings
RATE_LIMIT=30
AUTO_DELETE_MINUTES=10
PAGE_SIZE=8

# Web admin dashboard secret (required to enable /api/admin/* and the dashboard)
# Use a long random string. When unset, the admin API is disabled.
ADMIN_PANEL_SECRET=change_me_to_a_long_random_secret

# Number of independent MTProto sessions for concurrent video streams (1-8)
STREAM_POOL_SIZE=3

# Optional: Google Gemini AI Concierge API key
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram MTProto Streaming Credentials (from https://my.telegram.org)
# Required for high-bitrate video streaming bypassing the 20MB bot limit
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789
# Telegram Storage Channel (ID of your private media channel)
STORAGE_CHANNEL=-100xxxxxxxxxx

# Web Server Configuration
HOST=0.0.0.0
PORT=8080

# Optional: Sub-Bot Worker (worker/rss_sub_bot.py)
SUB_BOT_TOKEN=your_sub_bot_token_from_botfather
SUBSPLEASE_RSS=https://subsplease.org/rss/?r=1080
CHECK_INTERVAL_SECONDS=300

# Optional: debrid-powered RSS ingestion (downloads real episodes and uploads
# them to the storage channel so they become streamable on the website).
# Without a key the worker only posts magnet-link notifications.
DEBRID_API_KEY=your_realdebrid_or_alldebrid_api_key
DEBRID_PROVIDER=realdebrid
MAX_DOWNLOADS_PER_RUN=3
INGEST_TMP_DIR=/data/ingest_tmp
